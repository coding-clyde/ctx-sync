{
  "name": "ctx-syncr",
  "version": "0.1.0",
  "description": "Compile AI context rules from .ai/ into native editor files, audit token usage, and catch leaked secrets in CI.",
  "type": "module",
  "license": "MIT",
  "author": "ctx-syncr contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-clyde/ctx-sync.git"
  },
  "homepage": "https://github.com/coding-clyde/ctx-sync#readme",
  "bugs": {
    "url": "https://github.com/coding-clyde/ctx-sync/issues"
  },
  "keywords": [
    "ctx-syncr",
    "ai",
    "context",
    "claude",
    "cursor",
    "copilot",
    "windsurf",
    "cli",
    "developer-tools",
    "secrets",
    "tokens"
  ],
  "bin": {
    "ctx-syncr": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try { require('node:fs').chmodSync('dist/index.js', 0o755) } catch {}\"",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test .test-build/tests/*.test.js",
    "start": "node dist/index.js",
    "sync": "npm run build && node dist/index.js sync",
    "check": "npm run build && node dist/index.js check",
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','.test-build']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
